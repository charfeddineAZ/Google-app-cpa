{
  "problemMatcher": [
    {
      "owner": "gradle-task-failed",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(Execution failed for task '(.+)')\\.?$",
          "message": 1
        }
      ]
    },
    {
      "owner": "gradle-failure-cause",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^> (Could not .+|Failed to .+|Unable to .+|Duplicate class .+|Module with classpath .+)$",
          "message": 1
        }
      ]
    },
    {
      "owner": "gradle-build-failed",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(FAILURE: Build (?:failed|completed) with an exception\\.)$",
          "message": 1
        }
      ]
    }
  ]
}
